# 단독 compose 의 설정. 이 파일을 .env 로 복사해 채우고, 비밀 값이 들어 있으니 운영자만 읽게 둔다.
#   cp .env.example .env && chmod 600 .env
# 서버, 작업자, 마이그레이션 컨테이너가 이 파일을 통째로 받는다. 설정 문서에 있는 RAG_* 설정은 compose 를 고치지
# 않고 여기에 더한다.

# 이미지의 이름공간과 번호. 묶음을 만든 릴리스의 값이 이미 적혀 있다. 고치지 않는다.
RAG_ENGINE_NAMESPACE=@RAG_ENGINE_NAMESPACE@
RAG_ENGINE_VERSION=@RAG_ENGINE_VERSION@

# 꼭 채우는 값 둘. 비어 있으면 컨테이너를 하나도 띄우지 않고 무엇이 없는지 적고 멈춘다.
# 서버 이름. 클라이언트가 접속하는 이름을 쉼표로 적는다(예: rag.example.com).
RAG_ALLOWED_HOSTS=
# 데이터베이스 비밀번호. 데이터베이스 주소에 들어가므로 16진수로 만든다(openssl rand -hex 24).
POSTGRES_PASSWORD=

# 서버 /tmp 의 크기 상한. 비우면 1g. RAG_MAX_UPLOAD_MB 를 올리는 설치가 함께 올린다.
# RAG_ENGINE_SERVER_TMP_SIZE=1g

# 리랭커를 켜는 설치(docker compose --profile reranker ...)가 적는다.
# RAG_DEFAULT_RERANKER_URL=http://reranker:80

# 서버 기계의 원천 폴더. 서버와 작업자의 /sources 에 읽기 전용으로 붙는다. 비우면 설치 폴더의 sources/ 다.
# 절대 경로나 ./ 로 시작하는 경로를 적는다. data/src 처럼 적으면 폴더가 아니라 이름 붙은 볼륨으로 읽혀 compose 가 undefined volume 오류로 멈춘다.
# 원천은 이 폴더 아래의 하위 폴더 하나씩이다. 바꾼 뒤에는 서버와 작업자를 다시 만든다(docker compose up -d).
# RAG_ENGINE_SOURCES_DIR=/srv/rag-sources

# 원천의 일정(cron 표현식)을 읽는 시간대. 적지 않으면 Asia/Seoul. IANA 시간대 이름을 적는다.
# RAG_SCHEDULE_TIMEZONE=Asia/Seoul

# 지운 문서와 지운 원천을 복구할 수 있는 보관 기간(일). 적지 않으면 30. 이 기간이 지나면 하루에 한 번 도는 정리 작업이 완전히 지운다.
# RAG_DELETED_RETENTION_DAYS=30

# 동기화 기록의 보관 기간(일). 적지 않으면 90. 원천마다 가장 최근 기록 하나는 기간이 지나도 남는다.
# RAG_SYNC_RECORD_RETENTION_DAYS=90

# 서버 폴더의 파일 하나를 읽거나 목록의 다음 항목을 받는 일을 기다리는 한도(초). 적지 않으면 600. 느린 공유 폴더에서 늘린다.
# RAG_SOURCE_READ_TIMEOUT_SECONDS=600
